<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="none">
  <defs>
    <linearGradient id="oxGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00F2FE" />
      <stop offset="100%" stop-color="#4FACFE" />
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF3B30" />
      <stop offset="100%" stop-color="#FF9F43" />
    </linearGradient>
  </defs>
  <rect width="100" height="100" rx="28" fill="#0B0F17"/>
  <circle cx="50" cy="50" r="38" stroke="url(#oxGrad)" stroke-width="5" stroke-dasharray="6 4" opacity="0.3"/>
  <circle cx="50" cy="50" r="30" stroke="url(#oxGrad)" stroke-width="6"/>
  <!-- Soundwave pulses inside "O" -->
  <rect x="36" y="44" width="4" height="12" rx="2" fill="url(#accentGrad)" />
  <rect x="44" y="36" width="4" height="28" rx="2" fill="url(#oxGrad)" />
  <rect x="52" y="32" width="4" height="36" rx="2" fill="url(#oxGrad)" />
  <rect x="60" y="42" width="4" height="16" rx="2" fill="url(#accentGrad)" />
</svg>
