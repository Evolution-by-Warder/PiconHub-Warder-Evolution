<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <!-- plain dark backdrop, no branded border -->
  <rect width="64" height="64" rx="14" fill="#0f0d0a"/>

  <!-- soft red glow pulse (does not distort the symbol) -->
  <circle cx="32" cy="32" r="22" fill="#ff2d5a" opacity="0">
    <animate attributeName="opacity" values="0;0;0.14;0" dur="1.5s" repeatCount="indefinite"/>
  </circle>

  <!-- the circle -->
  <circle cx="32" cy="32" r="20" fill="none" stroke="#ff2d5a" stroke-width="5">
    <animate attributeName="r" values="19.6;20;19.6" dur="2.4s" repeatCount="indefinite"/>
  </circle>

  <!-- red slanted A: legs and crossbar poke slightly outside the circle -->
  <g transform="rotate(-7 32 36)" stroke="#ff2d5a" stroke-width="7" fill="none"
     stroke-linecap="round" stroke-linejoin="round">
    <path d="M30 15 L23 55"/>
    <path d="M30 15 L40 53"/>
    <path d="M9 41 L56 33"/>
  </g>

  <!-- rare glitch sliver -->
  <rect x="2" y="2" width="60" height="2" fill="#fff" opacity="0">
    <animate attributeName="opacity" values="0;0;0;0.5;0" dur="1.3s" repeatCount="indefinite"/>
  </rect>
</svg>