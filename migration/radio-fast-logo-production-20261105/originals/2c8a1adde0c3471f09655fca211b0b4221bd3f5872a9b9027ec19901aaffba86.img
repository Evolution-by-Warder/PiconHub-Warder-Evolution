<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 200" width="400" height="200">
  <defs>
    <linearGradient id="waveGradA" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%"   stop-color="#c98a4b" stop-opacity="0.3"/>
      <stop offset="40%"  stop-color="#c98a4b" stop-opacity="1"/>
      <stop offset="60%"  stop-color="#f0c896" stop-opacity="1"/>
      <stop offset="100%" stop-color="#f0c896" stop-opacity="0.3"/>
    </linearGradient>
    <linearGradient id="textGradA" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%"   stop-color="#c98a4b"/>
      <stop offset="100%" stop-color="#f0c896"/>
    </linearGradient>
    <filter id="glowA">
      <feGaussianBlur stdDeviation="2.5" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <clipPath id="waveClipA">
      <rect x="20" y="55" width="360" height="60"/>
    </clipPath>
  </defs>

  <!-- Background -->
  <rect width="400" height="200" fill="#1c1c1e" rx="12"/>

  <!-- Subtle grid lines -->
  <line x1="0" y1="85"  x2="400" y2="85"  stroke="#ffffff" stroke-opacity="0.04" stroke-width="1"/>
  <line x1="0" y1="100" x2="400" y2="100" stroke="#ffffff" stroke-opacity="0.06" stroke-width="1"/>
  <line x1="0" y1="115" x2="400" y2="115" stroke="#ffffff" stroke-opacity="0.04" stroke-width="1"/>

  <!-- Audio waveform bars (left side — analog wave) -->
  <g filter="url(#glowA)" clip-path="url(#waveClipA)">
    <rect x="22"  y="91"  width="5" height="18" rx="2" fill="url(#waveGradA)" opacity="0.5"/>
    <rect x="30"  y="79"  width="5" height="42" rx="2" fill="url(#waveGradA)" opacity="0.6"/>
    <rect x="38"  y="68"  width="5" height="64" rx="2" fill="url(#waveGradA)" opacity="0.8"/>
    <rect x="46"  y="74"  width="5" height="52" rx="2" fill="url(#waveGradA)" opacity="0.7"/>
    <rect x="54"  y="61"  width="5" height="78" rx="2" fill="url(#waveGradA)"/>
    <rect x="62"  y="71"  width="5" height="58" rx="2" fill="url(#waveGradA)" opacity="0.9"/>
    <rect x="70"  y="57"  width="5" height="86" rx="2" fill="url(#waveGradA)"/>
    <rect x="78"  y="64"  width="5" height="72" rx="2" fill="url(#waveGradA)" opacity="0.95"/>
    <rect x="86"  y="60"  width="5" height="80" rx="2" fill="url(#waveGradA)"/>
    <rect x="94"  y="69"  width="5" height="62" rx="2" fill="url(#waveGradA)" opacity="0.85"/>
    <rect x="102" y="75"  width="5" height="50" rx="2" fill="url(#waveGradA)" opacity="0.75"/>
    <rect x="110" y="82"  width="5" height="36" rx="2" fill="url(#waveGradA)" opacity="0.6"/>
    <rect x="118" y="88"  width="5" height="24" rx="2" fill="url(#waveGradA)" opacity="0.5"/>
    <rect x="126" y="79"  width="5" height="22" rx="1" fill="url(#waveGradA)" opacity="0.55"/>
    <rect x="134" y="79"  width="5" height="42" rx="1" fill="url(#waveGradA)" opacity="0.65"/>
  </g>

  <!-- Code characters replacing waveform (right side) -->
  <g font-family="'Courier New', Courier, monospace" font-size="13" fill="url(#textGradA)" filter="url(#glowA)">
    <text x="144" y="88">1</text>
    <text x="144" y="104">0</text>
    <text x="157" y="82">0</text>
    <text x="157" y="96">1</text>
    <text x="157" y="110">1</text>
    <text x="170" y="79">1</text>
    <text x="170" y="93">0</text>
    <text x="170" y="107">0</text>
    <text x="183" y="76">1</text>
    <text x="183" y="90">1</text>
    <text x="183" y="104">0</text>
    <text x="183" y="118">1</text>
    <text x="196" y="80">0</text>
    <text x="196" y="94">1</text>
    <text x="196" y="108">0</text>
    <text x="209" y="84">1</text>
    <text x="209" y="98">1</text>
    <text x="209" y="112">0</text>
    <text x="222" y="81">0</text>
    <text x="222" y="95">1</text>
    <text x="222" y="109">1</text>
    <text x="235" y="78">1</text>
    <text x="235" y="92">0</text>
    <text x="235" y="106">1</text>
    <text x="235" y="120">0</text>
    <text x="248" y="83">0</text>
    <text x="248" y="97">1</text>
    <text x="261" y="88">1</text>
    <text x="261" y="102">0</text>
    <text x="274" y="84" opacity="0.7">1</text>
    <text x="274" y="98" opacity="0.7">1</text>
    <text x="287" y="90" opacity="0.5">0</text>
    <text x="287" y="104" opacity="0.5">1</text>
    <text x="300" y="93" opacity="0.3">0</text>
    <text x="313" y="96" opacity="0.15">1</text>
  </g>

  <!-- Divider line between wave and code zones -->
  <line x1="140" y1="55" x2="140" y2="115" stroke="#c98a4b" stroke-width="1" stroke-opacity="0.4" stroke-dasharray="3,3"/>

  <!-- Station name -->
  <text x="200" y="152"
        font-family="'Courier New', Courier, monospace"
        font-size="22"
        font-weight="bold"
        fill="url(#textGradA)"
        text-anchor="middle"
        letter-spacing="3"
        filter="url(#glowA)">RÁDIO ALGORITMO</text>

  <!-- Tagline -->
  <text x="200" y="172"
        font-family="'Courier New', Courier, monospace"
        font-size="10"
        fill="#e8e6e1"
        fill-opacity="0.45"
        text-anchor="middle"
        letter-spacing="2">WHERE MUSIC MEETS CODE</text>
</svg>
