<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
    <!-- Dunkler Hintergrund -->
    <rect width="64" height="64" rx="14" ry="14" fill="#141414"/>
    
    <!-- "C" in Gold -->
    <path d="M 44 18
             A 18 18 0 1 0 44 46
             L 40 41
             A 12 12 0 1 1 40 23
             Z"
          fill="#c8a96b"/>
    
    <!-- Moewe -->
    <path d="M 38 36
             Q 41 32 44 36
             Q 47 32 50 36"
          fill="none"
          stroke="#c8a96b"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"/>
    
    <!-- Welle unten -->
    <path d="M 26 50
             Q 32 47 38 50
             Q 44 53 50 50"
          fill="none"
          stroke="#c8a96b"
          stroke-width="1.5"
          stroke-linecap="round"
          opacity="0.7"/>
</svg>
