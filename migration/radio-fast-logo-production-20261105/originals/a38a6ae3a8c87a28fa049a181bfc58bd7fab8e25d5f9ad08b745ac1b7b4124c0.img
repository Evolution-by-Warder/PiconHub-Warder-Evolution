<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 1200" role="img" aria-labelledby="title desc">
<title id="title">NightGrid FM Deadnet Pirate Relay</title>
<desc id="desc">Black iron pirate-radio node artwork with brass telemetry rings, red intrusion traces, and a cyan live signal core.</desc>
<defs>
  <radialGradient id="bg" cx="42%" cy="35%" r="80%"><stop offset="0" stop-color="#242018"/><stop offset=".48" stop-color="#0c0b09"/><stop offset="1" stop-color="#030303"/></radialGradient>
  <linearGradient id="brass" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#e2c47b"/><stop offset=".48" stop-color="#98713a"/><stop offset="1" stop-color="#5c4021"/></linearGradient>
  <linearGradient id="bone" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#fff8e7"/><stop offset=".55" stop-color="#d9ccb1"/><stop offset="1" stop-color="#83775f"/></linearGradient>
  <filter id="glow"><feGaussianBlur stdDeviation="8" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  <pattern id="grid" width="80" height="80" patternUnits="userSpaceOnUse"><path d="M80 0H0V80" fill="none" stroke="#c9a35d" stroke-opacity=".07" stroke-width="2"/></pattern>
</defs>
<rect width="1200" height="1200" fill="url(#bg)"/>
<rect width="1200" height="1200" fill="url(#grid)"/>
<path d="M46 210V46h164M990 46h164v164M1154 990v164H990M210 1154H46V990" fill="none" stroke="#c9a35d" stroke-width="6" opacity=".72"/>
<path d="M78 256h220M902 78v132M1122 740v222M78 930h150" stroke="#c52f36" stroke-width="5" opacity=".72"/>
<circle cx="600" cy="570" r="390" fill="none" stroke="#c9a35d" stroke-width="8" opacity=".62"/>
<circle cx="600" cy="570" r="315" fill="none" stroke="#6e5530" stroke-width="3" stroke-dasharray="18 12"/>
<circle cx="600" cy="570" r="246" fill="none" stroke="#c52f36" stroke-width="5" stroke-dasharray="8 18" opacity=".82"/>
<circle cx="600" cy="570" r="168" fill="#071414" stroke="#26d8df" stroke-width="7" filter="url(#glow)" opacity=".94"/>
<circle cx="600" cy="570" r="118" fill="none" stroke="#8ee8e5" stroke-width="2" opacity=".68"/>
<g fill="none" stroke="#c9a35d" stroke-width="4" opacity=".45">
  <path d="M600 118v96M600 926v96M148 570h96M956 570h96"/>
  <path d="M280 250l68 68M852 822l68 68M920 250l-68 68M348 822l-68 68"/>
</g>
<text x="600" y="535" fill="url(#bone)" font-family="Impact,Arial Narrow,sans-serif" font-size="132" letter-spacing="4" text-anchor="middle">NIGHTGRID</text>
<rect x="482" y="590" width="236" height="106" fill="#c9a35d" opacity=".92"/>
<rect x="494" y="602" width="212" height="82" fill="#090806" stroke="#26d8df" stroke-width="4"/>
<text x="600" y="666" fill="#8ee8e5" font-family="Arial Narrow,sans-serif" font-weight="700" font-size="74" letter-spacing="18" text-anchor="middle">FM</text>
<text x="600" y="780" fill="#c9a35d" font-family="monospace" font-size="25" letter-spacing="7" text-anchor="middle">DEADNET PIRATE RELAY // BR-NG-01</text>
<text x="600" y="824" fill="#8c806b" font-family="monospace" font-size="19" letter-spacing="4" text-anchor="middle">NO HOST // NO SCHEDULE // NO CORPORATE BAND</text>
<g font-family="monospace" font-size="18" fill="#c52f36" opacity=".88">
  <text x="82" y="108">RELAY/06</text><text x="900" y="108">ROUTE: UNLISTED</text><text x="82" y="1090">HUMAN DJ: OFFLINE</text><text x="885" y="1090">SIGNAL: LIVE</text>
</g>
</svg>
