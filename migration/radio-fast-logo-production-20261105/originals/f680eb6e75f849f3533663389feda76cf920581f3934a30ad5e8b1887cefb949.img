<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0A0A0B"/>
      <stop offset="100%" stop-color="#1A1A20"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#A78BFA"/>
      <stop offset="100%" stop-color="#7C3AED"/>
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="32" height="32" rx="8" fill="url(#bg)"/>
  <rect width="32" height="32" rx="8" fill="none" stroke="#8B5CF6" stroke-width="1" opacity="0.4"/>
  <!-- Stylized "tp" mark -->
  <text x="12" y="14" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="700" fill="url(#accent)" text-anchor="middle">t</text>
  <text x="21" y="23" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="700" fill="url(#accent)" text-anchor="middle" opacity="0.85">p</text>
  <!-- Subtle accent dot -->
  <circle cx="6" cy="6" r="2" fill="#8B5CF6" opacity="0.5"/>
</svg>
