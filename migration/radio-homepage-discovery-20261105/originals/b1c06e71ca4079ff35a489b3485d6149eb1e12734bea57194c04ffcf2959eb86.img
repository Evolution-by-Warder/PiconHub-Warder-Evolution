<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024" viewBox="0 0 1024 1024">
  <title>Mixtral app icon — balanced concept</title>
  <desc>A centered white Mixtral M framed symmetrically by the original waveform bars.</desc>
  <defs>
    <radialGradient id="background" cx="50%" cy="46%" r="72%">
      <stop offset="0" stop-color="#0b2053"/>
      <stop offset="0.58" stop-color="#000b3a"/>
      <stop offset="1" stop-color="#00062c"/>
    </radialGradient>
    <linearGradient id="waves" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ff4200"/>
      <stop offset="0.58" stop-color="#ff5d00"/>
      <stop offset="1" stop-color="#ffd900"/>
    </linearGradient>
    <g id="waveBars" fill="url(#waves)">
      <path d="m -124.06234,34.604643 c -3.39327,-1.42261 -3.80745,-20.55808 -0.48111,-22.22759 3.36115,-1.68698 5.19469,2.02977 5.1835,10.50741 -0.012,9.0946 -1.58912,13.0254 -4.70239,11.72018 z"/>
      <path d="m -92.367597,42.707833 c -1.564073,-0.75024 -2.144447,-3.04657 -2.779403,-10.99708 -0.858963,-10.75538 -0.206138,-23.2614101 1.369999,-26.2447901 1.218934,-2.30725 3.663179,-2.2012 4.72153,0.20487 2.371799,5.3920601 2.526718,28.0670001 0.237501,34.7620601 -0.697856,2.04096 -2.127397,2.95714 -3.549627,2.27494 z"/>
      <path d="m -114.88786,43.019103 c -3.12003,-1.73179 -4.04182,-31.15472 -1.16934,-37.3244301 0.90288,-1.93927 3.24969,-2.51871 4.22171,-1.04236 3.19511,4.85284 2.87667,34.7024201 -0.40562,38.0211701 -0.62062,0.62752 -1.84972,0.78802 -2.64675,0.34562 z"/>
      <path d="m -103.66141,62.004564 c -2.89963,-1.19794 -3.65827,-9.090891 -3.64853,-37.959231 0.009,-27.1093801 0.67332,-36.51681 2.71505,-38.45623 2.05804,-1.95492 4.34321,-0.57248 5.066652,3.06513 2.769834,13.9273899 2.280938,66.83642 -0.667642,72.252621 -0.65791,1.20851 -2.0953,1.6638 -3.46553,1.09771 z"/>
    </g>
  </defs>

  <!-- Square master artwork; mobile platforms apply their own corner mask. -->
  <rect width="1024" height="1024" fill="url(#background)"/>

  <!-- The original waveform is mirrored to create equal visual weight. -->
  <use href="#waveBars" transform="translate(783 380) scale(5.6)"/>
  <use href="#waveBars" transform="translate(241 380) scale(-5.6 5.6)"/>

  <!-- Original Mixtral M, optically centered. -->
  <path fill="#ffffff" transform="translate(1054 334) scale(10)" d="m -73.912911,36.052303 -1.521354,-0.0941 V 17.749673 -0.45885706 h 5.006081 5.00608 l 2.177592,3.58138996 c 4.977808,8.1867701 6.20209,10.2347601 7.508373,12.5600701 l 1.373091,2.44425 2.209901,-3.82653 c 2.663408,-4.6118001 4.283796,-7.2598801 5.878634,-9.6070101 0.657469,-0.9676 1.610177,-2.4944 2.11713,-3.39289 l 0.921732,-1.63360996 5.067359,-0.0683 5.067359,-0.0683 V 17.616213 c 0,13.37783 -0.07935,18.13259 -0.30482,18.26495 -0.591232,0.3471 -9.19287,0.43645 -9.619736,0.0999 -0.335646,-0.2646 -0.395239,-1.65934 -0.401234,-9.39052 -0.0064,-8.20835 -0.04537,-9.01946 -0.406462,-8.45145 -0.219682,0.34557 -2.050458,3.28608 -4.068392,6.53446 -4.554722,7.33198 -3.925999,6.69885 -6.631041,6.67754 l -2.212699,-0.0174 -0.916491,-1.50795 c -0.504069,-0.82937 -1.871063,-2.9782 -3.037763,-4.77518 -1.166701,-1.79697 -2.69561,-4.22707 -3.397576,-5.40022 l -1.276303,-2.133 -0.06947,9.29576 -0.06947,9.29577 -3.439583,0.0187 c -1.891771,0.0103 -4.124193,-0.0236 -4.960938,-0.0754 z"/>
</svg>
