@echo off
setlocal EnableExtensions
set "WARDER_DIAG_OUT=%TEMP%\WARDER-PICON-FACTORY-diagnostic-%RANDOM%-%RANDOM%.txt"
powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 (
  echo Diagnostic failed. No Factory files were changed.
  pause
  exit /b 1
)
echo.
echo Send the report file shown above for diagnosis.
if not defined WARDER_DIAG_NO_PAUSE pause
